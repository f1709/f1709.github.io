obs = obslua

-- KillCounter+∞ for OBS
-- + : increase counter
-- - : decrease counter
-- P : toggle + symbol
-- I : toggle ∞ symbol

start_number = 0
step_number = 1
counter = start_number
source_name = "KillCounter"
format_text = "Kills: %d"

plus_mode = false
infinity_mode = false

hotkey_inc = obs.OBS_INVALID_HOTKEY_ID
hotkey_dec = obs.OBS_INVALID_HOTKEY_ID
hotkey_plus = obs.OBS_INVALID_HOTKEY_ID
hotkey_infinity = obs.OBS_INVALID_HOTKEY_ID

function script_description()
    return "KillCounter+∞ : +/−로 숫자 증가/감소, P로 + 기호, I로 ∞ 기호 토글"
end

function script_properties()
    local props = obs.obs_properties_create()

    obs.obs_properties_add_text(
        props,
        "source",
        "Text Source Name",
        obs.OBS_TEXT_DEFAULT
    )

    -- Start Number: OBS 입력 범위 제한 없음
    obs.obs_properties_add_text(
        props,
        "start_number",
        "Start Number",
        obs.OBS_TEXT_DEFAULT
    )

    -- Step Number: OBS 입력 범위 제한 없음
    obs.obs_properties_add_text(
        props,
        "step_number",
        "Step Number",
        obs.OBS_TEXT_DEFAULT
    )

    obs.obs_properties_add_text(
        props,
        "format_text",
        "Format Text",
        obs.OBS_TEXT_DEFAULT
    )

    obs.obs_properties_add_text(
        props,
        "info",
        "Hotkeys: + = Increase, - = Decrease, P = Plus, I = Infinity",
        obs.OBS_TEXT_INFO
    )

    return props
end

function script_update(settings)
    source_name = obs.obs_data_get_string(settings, "source")

    if source_name == "" then
        source_name = "KillCounter"
    end

    -- Start Number와 Step Number는 텍스트로 입력받아
    -- OBS 속성창의 고정된 최소/최대 범위를 사용하지 않습니다.
    local start_text = obs.obs_data_get_string(settings, "start_number")
    local step_text = obs.obs_data_get_string(settings, "step_number")

    start_number = tonumber(start_text) or 0
    step_number = tonumber(step_text) or 1

    if step_number == 0 then
        step_number = 1
    end

    format_text = obs.obs_data_get_string(settings, "format_text")

    if format_text == "" then
        format_text = "Kills: %d"
    end

    counter = start_number
    update_text()
end

function update_text()
    local source = obs.obs_get_source_by_name(source_name)

    if source ~= nil then
        local settings = obs.obs_data_create()

        local display = string.format(
            format_text,
            counter,
            start_number,
            step_number
        )

        if plus_mode then
            display = display .. "+"
        end

        if infinity_mode then
            display = display .. "∞"
        end

        obs.obs_data_set_string(settings, "text", display)
        obs.obs_source_update(source, settings)

        obs.obs_data_release(settings)
        obs.obs_source_release(source)
    end
end

function increment_counter(pressed)
    if pressed then
        counter = counter + step_number
        update_text()
    end
end

function decrement_counter(pressed)
    if pressed then
        counter = counter - step_number
        update_text()
    end
end

function toggle_plus(pressed)
    if pressed then
        plus_mode = not plus_mode
        update_text()
    end
end

function toggle_infinity(pressed)
    if pressed then
        infinity_mode = not infinity_mode
        update_text()
    end
end

function script_load(settings)
    -- + 키: 숫자 증가
    hotkey_inc = obs.obs_hotkey_register_frontend(
        "kill_counter_inc",
        "Increase Kill Counter (+)",
        increment_counter
    )

    -- - 키: 숫자 감소
    hotkey_dec = obs.obs_hotkey_register_frontend(
        "kill_counter_dec",
        "Decrease Kill Counter (-)",
        decrement_counter
    )

    -- P 키: + 기호 토글
    hotkey_plus = obs.obs_hotkey_register_frontend(
        "kill_counter_plus",
        "Toggle Plus Symbol (P)",
        toggle_plus
    )

    -- I 키: ∞ 기호 토글
    hotkey_infinity = obs.obs_hotkey_register_frontend(
        "kill_counter_infinity",
        "Toggle Infinity Symbol (I)",
        toggle_infinity
    )

    local a = obs.obs_data_get_array(settings, "kill_counter_inc")
    obs.obs_hotkey_load(hotkey_inc, a)
    obs.obs_data_array_release(a)

    a = obs.obs_data_get_array(settings, "kill_counter_dec")
    obs.obs_hotkey_load(hotkey_dec, a)
    obs.obs_data_array_release(a)

    a = obs.obs_data_get_array(settings, "kill_counter_plus")
    obs.obs_hotkey_load(hotkey_plus, a)
    obs.obs_data_array_release(a)

    a = obs.obs_data_get_array(settings, "kill_counter_infinity")
    obs.obs_hotkey_load(hotkey_infinity, a)
    obs.obs_data_array_release(a)

    update_text()
end

function script_save(settings)
    local a = obs.obs_hotkey_save(hotkey_inc)
    obs.obs_data_set_array(settings, "kill_counter_inc", a)
    obs.obs_data_array_release(a)

    a = obs.obs_hotkey_save(hotkey_dec)
    obs.obs_data_set_array(settings, "kill_counter_dec", a)
    obs.obs_data_array_release(a)

    a = obs.obs_hotkey_save(hotkey_plus)
    obs.obs_data_set_array(settings, "kill_counter_plus", a)
    obs.obs_data_array_release(a)

    a = obs.obs_hotkey_save(hotkey_infinity)
    obs.obs_data_set_array(settings, "kill_counter_infinity", a)
    obs.obs_data_array_release(a)
end
